<Window x:Class="StegoAnalysis.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StegoAnalysis.ViewModels"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Стегодектор" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="AccentButton">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004C87"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="DropZone">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="VerdictText">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть изображение" InputGestureText="Ctrl+O" Command="{Binding OpenImageCommand}"/>
                <MenuItem Header="_Сохранить результаты" InputGestureText="Ctrl+S" Command="{Binding SaveReportCommand}"/>
                <Separator/>
                <MenuItem Header="_Выход" InputGestureText="Alt+F4" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Анализ">
                <MenuItem Header="Хи-квадрат" Command="{Binding ChiSquareCommand}"/>
                <MenuItem Header="RS-анализ" Command="{Binding RsCommand}"/>
                <MenuItem Header="DCT-анализ" Command="{Binding DctCommand}"/>
                <MenuItem Header="Вейвлет-анализ" Command="{Binding WaveletCommand}"/>
                <Separator/>
                <MenuItem Header="Все методы" Command="{Binding RunAnalysisCommand}"/>
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Основная рабочая область -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: результаты -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" 
                    BorderBrush="#E0E0E0" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Анализ изображения" FontWeight="Bold" FontSize="16" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <Border Background="#F9F9F9" CornerRadius="6" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1"
                            Visibility="{Binding VerdictVisibility}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="16" Height="16" CornerRadius="8" Background="{Binding VerdictColor}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding VerdictText}" Style="{StaticResource VerdictText}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding VerdictJustification}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,16,0,12" Background="#E0E0E0" Height="1"/>
                    <TextBlock Text="Результаты" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <ListView ItemsSource="{Binding AnalysisResults}" BorderThickness="0" MaxHeight="300">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Метод" Width="140" DisplayMemberBinding="{Binding Method}"/>
                                <GridViewColumn Header="Значение" Width="150" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Правая колонка: изображение, кнопка, гистограмма -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Изображение  -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопка анализа -->
                    <RowDefinition Height="Auto"/>
                    <!-- Гистограмма -->
                </Grid.RowDefinitions>

                <!-- Изображение -->
                <Border Grid.Row="0" Style="{StaticResource DropZone}" 
                        AllowDrop="True" DragEnter="OnDragEnter" Drop="OnImageDrop"
                        Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Visibility="{Binding ImagePlaceholderVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Перетащите изображение сюда" Foreground="#888888" FontSize="14" Margin="0,0,0,12"/>
                            <Button Content="Выбрать файл" Command="{Binding OpenImageCommand}"
                                    Style="{StaticResource AccentButton}" Width="140" Height="36"/>
                        </StackPanel>
                        <!-- Изображение -->
                        <Image Source="{Binding LoadedImage}" Visibility="{Binding LoadedImageVisibility}"
                               Stretch="Uniform" Margin="12"/>
                    </Grid>
                </Border>

                <!-- Кнопка анализа -->
                <Button Grid.Row="1" Content="Анализ изображения" 
                        Command="{Binding RunAnalysisCommand}"
                        Style="{StaticResource AccentButton}"
                        Margin="0,10,0,10" Height="44" FontSize="15"
                        Visibility="{Binding AnalysisButtonVisibility}"/>

                <!-- Гистограмма -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" 
                        BorderBrush="#E0E0E0" BorderThickness="1" Padding="12"
                        Visibility="{Binding HistogramVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Гистограмма" FontWeight="SemiBold" 
                                   FontSize="14" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <oxy:PlotView Grid.Row="1" Model="{Binding HistogramModel}" Height="200"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>